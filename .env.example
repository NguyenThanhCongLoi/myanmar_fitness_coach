DATABASE_URL=file:/data/fitness.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-private-random-secret
# Configure later via the project's Modal Secret, never NEXT_PUBLIC_*:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Myanmar voice (TTS), OpenAI-compatible gateway. Leave blank to disable server voice.
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=
TTS_MODEL=
# English voice (TTS) — a separate API. Leave blank to fall back to the browser voice for English.
TTS_EN_BASE_URL=
TTS_EN_API_KEY=
TTS_EN_VOICE=
TTS_EN_MODEL=

# Emails allowed to open the Admin usage analytics page (comma separated)
ADMIN_EMAILS=
